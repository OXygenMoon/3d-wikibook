{
  "name": "cubicles-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local, playable reconstruction of the Cubicles office world with a PostgreSQL foundation.",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node server.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "e2e:server": "node scripts/e2e-server.mjs",
    "check": "node scripts/check.mjs && npm run lint",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import": "node scripts/db-import.mjs",
    "db:rollback": "node scripts/db-rollback.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore-drill": "node scripts/db-restore-drill.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@sentry/node": "^11.8.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
