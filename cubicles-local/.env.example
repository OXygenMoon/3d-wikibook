# Copy to .env for local development. Never commit real secrets.

# HTTP
HOST=127.0.0.1
PORT=4173
CUBICLES_PORT=4173
LOG_LEVEL=info
NODE_ENV=development

# Database
# Leave DATABASE_URL empty to use embedded PGlite (no Docker required).
# DATABASE_URL=postgres://cubicles:cubicles@127.0.0.1:5432/cubicles
PGLITE_DIR=.local-data/pglite
PG_POOL_MAX=10

# Docker Compose PostgreSQL
POSTGRES_USER=cubicles
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cubicles

# Local data and backups
CUBICLES_DATA_DIR=.local-data
CUBICLES_BACKUP_DIR=backups
AUTO_IMPORT=true
CUBICLES_IMPORT_FILE=.local-data/community.json

# Accounts and sessions
DEFAULT_ADMIN_USERNAME=lzy
DEFAULT_ADMIN_PASSWORD=change-me
SESSION_TTL_DAYS=7
SESSION_PERSIST_INTERVAL_MS=2000
COOKIE_SECURE=false
REQUIRE_LOGIN=true
# Set when behind a reverse proxy, e.g. https://community.example.com
PUBLIC_ORIGIN=

# Browser-accessible WikiBook OJ URL; leave empty to disable. No password or token.
WIKIBOOK_OJ_URL=http://127.0.0.1:5009/oj/problems
WIKIBOOK_FISHING_URL=http://127.0.0.1:5009/fishing

# Optional account linking. Same random 32+ character secret on both backends only.
# WikiBook uses COMMUNITY_SSO_SECRET and COMMUNITY_SSO_ORIGIN (= PUBLIC_ORIGIN).
WIKIBOOK_SSO_SECRET=
# Backend address, loopback on the same host or HTTPS. Never a browser URL.
WIKIBOOK_INTERNAL_URL=http://127.0.0.1:5009

# Error monitoring (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Safety limits
REQUEST_BODY_LIMIT=500000
MODEL_UPLOAD_LIMIT=20971520
