+def test_login_is_browser_bound_single_use_and_preserves_embed(app):
+    client = app.test_client()
+    linked(client, app)
+    code, state = ticket(client, app)
+    assert app.test_client().get('/community-sso/callback', query_string={'code': code, 'state': state}).status_code == 400
+    login(client, 2)
+    response = client.get('/community-sso/callback', query_string={'code': code, 'state': state})
+    assert response.status_code == 303 and response.location == '/fishing?embed=community-fishing'
+    with client.session_transaction() as session:
+        assert session['_user_id'] == '1:0'
+        assert session['_fresh']
+    assert client.get('/community-sso/callback', query_string={'code': code, 'state': state}).status_code == 400
+    code, state = ticket(client, app, 'oj', False)
+    response = client.get('/community-sso/callback', query_string={'code': code, 'state': state})
+    assert response.location == '/oj/problems'
