new file mode 100644
index 0000000..4b767d9
--- /dev/null
+++ b/tests/test_community_sso.py
@@ -0,0 +1,187 @@
+import base64
+import hashlib
+import hmac
+import json
+import secrets
+import time
+from urllib.parse import parse_qs, urlsplit
+
+import pytest
+
+from wikibook_app.extensions import db, login_manager
+from wikibook_app.factory import create_app
+from wikibook_app.models import User
+from wikibook_app.integrations.community_sso import CommunityAccount, CommunityCode
+
+
+@pytest.fixture
+def app(monkeypatch):
+    monkeypatch.setenv('DATABASE_URL', 'sqlite:///:memory:')
+    monkeypatch.setenv('COMMUNITY_SSO_SECRET', 'test-community-sso-secret-at-least-32-characters')
+    monkeypatch.setenv('COMMUNITY_SSO_ORIGIN', 'http://127.0.0.1:4173')
+    app = create_app()
+    app.config.update(TESTING=True, SESSION_COOKIE_SECURE=False)
+    previous_loader = login_manager._user_callback
+
+    @login_manager.user_loader
+    def load(value):
+        user = db.session.get(User, int(value.partition(':')[0]))
+        return user if user and user.get_id() == value else None
+
+    with app.app_context():
+        db.create_all()
+        for user_id in (1, 2):
+            user = User(id=user_id, username=f'wiki-{user_id}', email=f'{user_id}@test.invalid')
+            user.set_password('only-a-fixture-password')
+            db.session.add(user)
+        db.session.commit()
+    yield app
+    login_manager.user_loader(previous_loader)
+    with app.app_context():
+        db.session.remove()
+        db.drop_all()
+
+
+def login(client, user_id=1):
+    with client.session_transaction() as session:
+        session['_user_id'] = f'{user_id}:0'
+        session['_fresh'] = True
+
+
+def internal(client, app, action, community='community-1', **payload):
+    return client.post('/internal/community-sso', json={'action': action, 'communityId': community, **payload},
+                       headers={'Authorization': 'Bearer ' + app.config['COMMUNITY_SSO_SECRET']})
+
+
+def link_request(app, community='community-1', **overrides):
+    verifier = secrets.token_urlsafe(32)
+    payload = {'communityId': community, 'username': community, 'state': secrets.token_urlsafe(32),
+               'challenge': hashlib.sha256(verifier.encode()).hexdigest(), 'expires': int(time.time()) + 290, **overrides}
+    body = base64.urlsafe_b64encode(json.dumps(payload).encode()).decode().rstrip('=')
+    signature = base64.urlsafe_b64encode(hmac.new(app.config['COMMUNITY_SSO_SECRET'].encode(), body.encode(), hashlib.sha256).digest()).decode().rstrip('=')
+    return body + '.' + signature, verifier
+
+
+def consent(client, app, community='community-1'):
+    signed, verifier = link_request(app, community)
+    assert client.get('/community-sso/authorize', query_string={'request': signed}).status_code == 200
+    with client.session_transaction() as session:
+        csrf = session['_community_link_csrf']
+    response = client.post('/community-sso/authorize', data={'csrf': csrf})
+    assert response.status_code == 303
+    query = parse_qs(urlsplit(response.location).query)
+    return query['code'][0], verifier
+
+
+def linked(client, app):
+    login(client)
+    code, verifier = consent(client, app)
+    assert internal(client, app, 'link_redeem', code=code, verifier=verifier).status_code == 200
+
+
+def test_link_requires_both_logins_signed_request_consent_and_pkce(app):
+    client = app.test_client()
+    signed, verifier = link_request(app)
+    response = client.get('/community-sso/authorize', query_string={'request': signed})
+    assert response.status_code == 302 and response.location.startswith('/login?next=')
+    login(client)
+    assert client.get('/community-sso/authorize').status_code == 200
+    assert client.post('/community-sso/authorize', data={'csrf': 'wrong'}).status_code == 400
+    code, verifier = consent(client, app)
+    assert internal(client, app, 'link_redeem', code=code, verifier='x' * 43).status_code == 403
+    assert not internal(client, app, 'status').json['linked']
+    assert internal(client, app, 'link_redeem', code=code, verifier=verifier).status_code == 200
+    assert internal(client, app, 'link_redeem', code=code, verifier=verifier).status_code == 400
+    assert internal(client, app, 'status').json['username'] == 'wiki-1'
+    assert client.get('/community-sso/authorize', query_string={'request': signed[:-3] + 'bad'}).status_code == 400
+    expired, _ = link_request(app, expires=int(time.time()) - 1)
+    assert client.get('/community-sso/authorize', query_string={'request': expired}).status_code == 400
+    assert client.post('/internal/community-sso', json={'communityId': 'community-1', 'action': 'status'}).status_code == 401
