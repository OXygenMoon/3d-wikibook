+@pytest.mark.parametrize('change', ['password', 'unlink', 'expire', 'state'])
+def test_invalidated_or_tampered_ticket_cannot_login(app, change):
+    client = app.test_client()
+    linked(client, app)
+    code, state = ticket(client, app)
+    if change == 'password':
+        with app.app_context():
+            db.session.get(User, 1).set_password('changed-fixture-password')
+            db.session.commit()
+    if change == 'unlink':
+        internal(client, app, 'unlink')
+    if change == 'expire':
+        with app.app_context():
+            CommunityCode.query.update({'expires': 1})
+            db.session.commit()
+    if change == 'state':
+        state = secrets.token_urlsafe(32)
+    response = client.get('/community-sso/callback', query_string={'code': code, 'state': state})
+    assert response.status_code in (400, 403)
