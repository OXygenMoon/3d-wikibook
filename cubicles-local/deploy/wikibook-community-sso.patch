+def ticket(client, app, module='fishing', embedded=True):
+    nonce = secrets.token_urlsafe(32)
+    response = client.get('/community-sso/prepare', query_string={'nonce': nonce, 'purpose': f'launch-{module}-{str(embedded).lower()}'})
+    assert response.status_code == 302
+    state = parse_qs(urlsplit(response.location).query)['state'][0]
+    issued = internal(client, app, 'login_issue', state=state, module=module, embedded=embedded)
+    assert issued.status_code == 200
+    return issued.json['code'], state
+
