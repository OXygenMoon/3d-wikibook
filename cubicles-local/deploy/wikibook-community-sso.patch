diff --git a/wikibook_app/integrations/community_sso.py b/wikibook_app/integrations/community_sso.py
new file mode 100644
index 0000000..5655a29
--- /dev/null
+++ b/wikibook_app/integrations/community_sso.py
@@ -0,0 +1,267 @@
+import base64
+import hashlib
+import hmac
+import json
+import os
+import re
+import secrets
+import time
+from urllib.parse import urlencode, urlsplit
+
+from flask import Blueprint, current_app, jsonify, redirect, render_template, request, session
+from flask_login import current_user, login_user, logout_user
+from sqlalchemy.exc import IntegrityError
+
+from wikibook_app.extensions import db
+from wikibook_app.models import User
+
+
+class CommunityAccount(db.Model):
+    __tablename__ = 'community_account_link'
+    community_id = db.Column(db.String(80), primary_key=True)
+    user_id = db.Column(db.Integer, db.ForeignKey('user.id', ondelete='CASCADE'), unique=True, nullable=False)
+    link_id = db.Column(db.String(64), nullable=False)
+    created_at = db.Column(db.BigInteger, nullable=False)
+
+
+class CommunityCode(db.Model):
+    __tablename__ = 'community_auth_code'
+    digest = db.Column(db.String(64), primary_key=True)
+    expires = db.Column(db.BigInteger, nullable=False, index=True)
+    purpose = db.Column(db.String(16), nullable=False)
+    payload = db.Column(db.JSON, nullable=False)
+
+
+class SsoError(Exception):
+    def __init__(self, message, status=400):
+        super().__init__(message)
+        self.status = status
+
+
+def community_origin():
+    value = current_app.config.get('COMMUNITY_SSO_ORIGIN', '').rstrip('/')
+    parsed = urlsplit(value)
+    if (parsed.scheme not in {'http', 'https'} or not parsed.netloc
+            or parsed.path or parsed.query or parsed.fragment or parsed.username or parsed.password):
+        raise SsoError('3D 社区地址配置无效。', 503)
+    return value
+
+
+def secret():
+    value = current_app.config.get('COMMUNITY_SSO_SECRET', '')
+    if len(value) < 32:
+        raise SsoError('社区账号关联尚未配置。', 503)
+    community_origin()
+    return value
+
+
+def user_version(user):
+    if not user or not user.is_active or getattr(user, 'must_change_password', False):
+        raise SsoError('WikiBook 账号不可用，请先完成密码更新。', 403)
+    return hashlib.sha256((user.password_hash + ':' + str(getattr(user, 'session_version', 0))).encode()).hexdigest()
+
+
+def token_valid(value):
+    return isinstance(value, str) and re.fullmatch(r'[A-Za-z0-9_-]{43}', value) is not None
+
+
+def verify_link(value):
+    try:
+        if not isinstance(value, str) or len(value) > 2000:
+            raise ValueError()
+        body, signature = value.split('.')
+        expected = base64.urlsafe_b64encode(hmac.new(secret().encode(), body.encode(), hashlib.sha256).digest()).decode().rstrip('=')
+        if not hmac.compare_digest(signature, expected):
+            raise ValueError()
+        payload = json.loads(base64.urlsafe_b64decode(body + '=' * (-len(body) % 4)))
+        if (not isinstance(payload, dict) or not isinstance(payload.get('communityId'), str)
+                or not 1 <= len(payload['communityId']) <= 80
+                or not isinstance(payload.get('username'), str) or len(payload['username']) > 80
+                or not token_valid(payload.get('state'))
+                or not re.fullmatch(r'[a-f0-9]{64}', str(payload.get('challenge', '')))
+                or type(payload.get('expires')) is not int
+                or not time.time() < payload['expires'] <= time.time() + 310):
+            raise ValueError()
+        return payload
+    except (ValueError, TypeError, UnicodeError):
+        raise SsoError('关联请求已失效，请回到社区重新发起。') from None
+
+
+def issue_code(purpose, payload):
+    code = secrets.token_urlsafe(32)
+    CommunityCode.query.filter(CommunityCode.expires < int(time.time())).delete()
+    db.session.add(CommunityCode(digest=hashlib.sha256(code.encode()).hexdigest(), purpose=purpose,
+                                 expires=int(time.time()) + 60, payload=payload))
+    db.session.commit()
+    return code
+
+
+def consume_code(code, purpose):
+    if not token_valid(code):
+        raise SsoError('一次性凭证无效。')
+    digest = hashlib.sha256(code.encode()).hexdigest()
+    row = db.session.execute(db.delete(CommunityCode).where(
+        CommunityCode.digest == digest, CommunityCode.purpose == purpose,
+        CommunityCode.expires > int(time.time())).returning(CommunityCode.payload)).first()
+    if not row:
+        raise SsoError('一次性凭证已使用或过期，请重新发起。')
+    return row[0]
+
+
+def callback_url(path, **params):
+    return community_origin() + path + ('?' + urlencode(params) if params else '')
+
+
+def init_community_sso(app):
+    app.config.setdefault('COMMUNITY_SSO_SECRET', os.environ.get('COMMUNITY_SSO_SECRET', ''))
+    app.config.setdefault('COMMUNITY_SSO_ORIGIN', os.environ.get('COMMUNITY_SSO_ORIGIN', ''))
+    bp = Blueprint('community_sso', __name__)
+
+    @bp.after_request
+    def private(response):
+        response.headers['Cache-Control'] = 'no-store'
+        response.headers['Referrer-Policy'] = 'no-referrer'
+        if request.endpoint in {'community_sso.prepare', 'community_sso.callback'}:
+            response.headers.pop('X-Frame-Options', None)
+            try:
+                response.headers['Content-Security-Policy'] = "frame-ancestors 'self' " + community_origin()
+            except SsoError:
+                response.headers['Content-Security-Policy'] = "frame-ancestors 'none'"
+        else:
+            response.headers['X-Frame-Options'] = 'DENY'
+        return response
+
+    @bp.errorhandler(SsoError)
+    def error(exc):
+        db.session.rollback()
+        if request.path.startswith('/internal/'):
+            return jsonify(ok=False, error=str(exc)), exc.status
+        return render_template('community_sso.html', error=str(exc)), exc.status
+
+    @bp.get('/community-sso/authorize')
+    def authorize():
+        value = request.args.get('request') or session.get('_community_link_request')
+        payload = verify_link(value)
+        session['_community_link_request'] = value
+        if not current_user.is_authenticated:
+            return redirect('/login?' + urlencode({'next': '/community-sso/authorize'}))
+        user_version(current_user)
+        session['_community_link_actor'] = {'id': current_user.id, 'version': user_version(current_user)}
+        csrf = secrets.token_urlsafe(32)
+        session['_community_link_csrf'] = csrf
+        return render_template('community_sso.html', source=payload['username'], local=current_user.username, csrf=csrf)
+
+    @bp.post('/community-sso/authorize')
+    def confirm():
+        if not current_user.is_authenticated:
+            raise SsoError('请先登录 WikiBook。', 401)
+        csrf = session.pop('_community_link_csrf', '')
+        if not csrf or not hmac.compare_digest(csrf, request.form.get('csrf', '')):
+            raise SsoError('页面已过期，请重新发起关联。')
+        actor = session.pop('_community_link_actor', {})
+        if actor.get('id') != current_user.id or actor.get('version') != user_version(current_user):
+            raise SsoError('WikiBook 登录账号已切换，请重新确认关联。', 403)
+        payload = verify_link(session.pop('_community_link_request', None))
+        code = issue_code('link', {**payload, 'wikiId': current_user.id, 'version': user_version(current_user)})
+        return redirect(callback_url('/api/wikibook/link/callback', code=code, state=payload['state']), code=303)
+
+    @bp.post('/community-sso/cancel')
+    def cancel():
+        csrf = session.pop('_community_link_csrf', '')
+        if not csrf or not hmac.compare_digest(csrf, request.form.get('csrf', '')):
+            raise SsoError('页面已过期，请返回社区。')
+        session.pop('_community_link_request', None)
+        session.pop('_community_link_actor', None)
+        return redirect(community_origin(), code=303)
+
+    @bp.get('/community-sso/prepare')
+    def prepare():
+        secret()
+        nonce, purpose = request.args.get('nonce'), request.args.get('purpose')
+        if not token_valid(nonce) or purpose not in {'launch-oj-true', 'launch-oj-false', 'launch-fishing-true', 'launch-fishing-false'}:
+            raise SsoError('跳转请求无效。')
+        state = secrets.token_urlsafe(32)
+        targets = {key: value for key, value in session.get('_community_sso_targets', {}).items() if value > time.time()}
+        if len(targets) >= 8:
+            targets.pop(next(iter(targets)))
+        targets[state] = time.time() + 120
+        session['_community_sso_targets'] = targets
+        return redirect(callback_url('/api/wikibook/continue', nonce=nonce, state=state, purpose=purpose))
+
+    @bp.get('/community-sso/callback')
+    def callback():
+        state = request.args.get('state', '')
+        targets = session.pop('_community_sso_targets', {})
+        if not token_valid(state) or targets.pop(state, 0) < time.time():
+            raise SsoError('跳转来自其他浏览器或已过期，请重新发起。')
+        payload = consume_code(request.args.get('code'), 'login')
+        if not hmac.compare_digest(payload['state'], state):
+            raise SsoError('跳转状态不一致。')
+        link = db.session.get(CommunityAccount, payload['communityId'])
+        if not link or link.link_id != payload['linkId'] or link.user_id != payload['wikiId']:
+            raise SsoError('账号关联已解除，请重新关联。', 403)
+        user = db.session.get(User, link.user_id)
+        if user_version(user) != payload['version']:
+            raise SsoError('账号凭证已更新，请重新发起。', 403)
+        db.session.commit()
+        logout_user()
+        session.clear()
+        session['_remember'] = 'clear'
+        session['_community_sso_targets'] = targets
+        login_user(user, remember=False, fresh=True)
+        path = '/oj/problems' if payload['module'] == 'oj' else '/fishing'
+        if payload['embedded']:
+            path += '?' + urlencode({'embed': 'community-' + payload['module']})
+        return redirect(path, code=303)
+
+    @bp.post('/internal/community-sso')
+    def internal():
+        expected = 'Bearer ' + secret()
+        if not hmac.compare_digest(request.headers.get('Authorization', '').encode(), expected.encode()):
+            raise SsoError('服务认证失败。', 401)
+        data = request.get_json(silent=True)
+        if not isinstance(data, dict) or not isinstance(data.get('communityId'), str) or not 1 <= len(data['communityId']) <= 80:
+            raise SsoError('账号标识无效。')
+        community_id, action = data['communityId'], data.get('action')
+        link = db.session.get(CommunityAccount, community_id)
+        if action == 'status':
+            user = db.session.get(User, link.user_id) if link else None
+            return jsonify(ok=True, linked=bool(user), username=user.username if user else None)
+        if action == 'unlink':
+            if link:
+                db.session.delete(link)
+            CommunityCode.query.filter(CommunityCode.payload['communityId'].as_string() == community_id).delete(synchronize_session=False)
+            db.session.commit()
+            return jsonify(ok=True)
+        if action == 'link_redeem':
+            payload = consume_code(data.get('code'), 'link')
+            verifier = data.get('verifier')
+            if (payload['communityId'] != community_id or not token_valid(verifier)
+                    or not hmac.compare_digest(payload['challenge'], hashlib.sha256(verifier.encode()).hexdigest())):
+                raise SsoError('关联验证失败。', 403)
+            user = db.session.get(User, payload['wikiId'])
+            if user_version(user) != payload['version']:
+                raise SsoError('账号凭证已更新，请重新发起。', 403)
+            other = CommunityAccount.query.filter_by(user_id=user.id).first()
+            if (link and link.user_id != user.id) or (other and other.community_id != community_id):
+                raise SsoError('其中一个账号已有关联，请先解除原关联。', 409)
+            if not link:
+                db.session.add(CommunityAccount(community_id=community_id, user_id=user.id, link_id=secrets.token_urlsafe(32), created_at=int(time.time())))
+            try:
+                db.session.commit()
+            except IntegrityError:
+                db.session.rollback()
+                raise SsoError('账号已有关联，请刷新后重试。', 409) from None
+            return jsonify(ok=True, linked=True, username=user.username)
+        if action == 'login_issue':
+            if not link:
+                raise SsoError('请先关联 WikiBook 账号。', 409)
+            if not token_valid(data.get('state')) or data.get('module') not in {'oj', 'fishing'} or type(data.get('embedded')) is not bool:
+                raise SsoError('跳转页面无效。')
+            user = db.session.get(User, link.user_id)
+            code = issue_code('login', {'communityId': community_id, 'linkId': link.link_id, 'wikiId': user.id,
+                                       'version': user_version(user), 'state': data['state'], 'module': data['module'], 'embedded': data['embedded']})
+            return jsonify(ok=True, code=code)
+        raise SsoError('未知账号操作。')
+
+    app.register_blueprint(bp)
