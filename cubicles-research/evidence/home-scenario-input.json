{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome Dev.app/Contents/MacOS/Google Chrome Dev",
    "headless": true
  },
  "start_url": {
    "url": "https://www.cubicles.lol/"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900,
      "device_scale_factor": 1
    },
    "timezone": "Asia/Shanghai",
    "reduced_motion": "no-preference"
  },
  "actions": [
    {
      "step_id": "load-world",
      "action": "wait_for_timeout",
      "duration_ms": 20000
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "network",
      "console"
    ],
    "network": {
      "response_body": false,
      "request_body": false,
      "header_values": false
    }
  }
}